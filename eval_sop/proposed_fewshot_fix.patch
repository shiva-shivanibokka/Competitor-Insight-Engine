@@ -137,6 +137,21 @@ def test_extract_competitors_dedups_and_filters(monkeypatch):
     assert len(out) == 2  # adyen deduped by domain
 
 
+def test_competitor_prompt_examples_are_fictional():
+    # The format example used to be Adyen / Braintree / Square with their real
+    # URLs. A small local model copied them into answers for unrelated
+    # companies (measured in eval_sop/, see RESULTS.md). Example URLs must use
+    # the reserved .example TLD (RFC 2606) so nothing in the prompt is a real
+    # company the model can echo.
+    import re
+
+    urls = re.findall(r"https?://[^\s\"')]+", analyzer.COMPETITOR_EXTRACTION_PROMPT)
+    assert urls, "prompt should still show the expected output format"
+    assert all(re.match(r"https?://[^/]+\.example(/|$)", u) for u in urls), urls
+    for real in ("Adyen", "Braintree", "Square"):
+        assert real not in analyzer.COMPETITOR_EXTRACTION_PROMPT
+
+
