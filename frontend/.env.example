# You usually do NOT need this file.
#
# The API is a service in the same Vercel project, so the deployed frontend
# reaches it same-origin at /api/* with no configuration at all. Running
# `vercel dev` from the repo root serves both halves the same way.
#
# Set this only if you are running the backend separately, e.g. with
# `uvicorn app:app --port 7860` in backend/ while `npm run dev` serves the UI.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:7860
